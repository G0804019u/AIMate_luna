{
  "expo": {
    "name": "Luna",
    "slug": "luna",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "scheme": "luna",
    "experiments": {
      "tsconfigPaths": true
    },
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-video"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone for speech-to-text functionality."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.thomino.luna",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
